#!/usr/bin/env python3
"""EmergeHelper launcher.

Resolves its own location (through symlinks, since this is normally linked
into ~/.local/bin) so the package imports without needing PYTHONPATH set.
"""

import os
import sys

_root = os.path.dirname(os.path.dirname(os.path.realpath(__file__)))
if _root not in sys.path:
    sys.path.insert(0, _root)

if __name__ == "__main__":
    # Completion runs on every Tab press, so it takes a direct route that
    # skips argparse and the merge machinery (psutil, the PTY monitor, the
    # resolver) entirely - none of which a lookup needs.
    if len(sys.argv) > 1 and sys.argv[1] == "complete":
        from emergehelper.complete import main as complete_main

        sys.exit(complete_main(sys.argv[2:]))

    from emergehelper.cli import main

    sys.exit(main())
